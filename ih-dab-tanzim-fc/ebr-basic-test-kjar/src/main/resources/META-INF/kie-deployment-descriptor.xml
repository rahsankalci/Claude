<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<deployment-descriptor xsi:schemaLocation="http://www.jboss.org/jbpm deployment-descriptor.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <persistence-unit>org.jbpm.domain</persistence-unit>
  <audit-persistence-unit>org.jbpm.domain</audit-persistence-unit>
  <audit-mode>JPA</audit-mode>
  <persistence-mode>JPA</persistence-mode>
  <!-- OpenShift'te coklu pod: instance basina ksession, pod'lar arasi paylasilan JVM durumu yok -->
  <runtime-strategy>PER_PROCESS_INSTANCE</runtime-strategy>
  <marshalling-strategies/>
  <event-listeners/>
  <task-event-listeners/>
  <globals/>
  <work-item-handlers>
    <!-- Avrasya otomatik aktiviteleri (ProgramID 54866, 269812 - mainframe) -->
    <work-item-handler>
      <resolver>mvel</resolver>
      <identifier>new com.garantibbva.processarchitecture.ihdabtanzimfc.handler.AvrasyaServiceWorkItemHandler()</identifier>
      <parameters/>
      <name>AvrasyaService</name>
    </work-item-handler>
  </work-item-handlers>
  <environment-entries/>
  <configurations/>
  <required-roles/>
  <remoteable-classes>
    <remoteable-class>com.garantibbva.processarchitecture.ebrbasictest.model.GkAll</remoteable-class>
    <remoteable-class>com.garantibbva.processarchitecture.ebrbasictest.model.GkWip</remoteable-class>
  </remoteable-classes>
  <limit-serialization-classes>true</limit-serialization-classes>
</deployment-descriptor>
